# ==============================================================================
# BhuVistaar V2 - .gitignore
# Geospatial AI Super-Resolution & Uncertainty Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python, Bytecode & Packaging
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets (Keep template files tracked)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.credentials
!.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 4. Deep Learning Models & Heavyweight Weights
# ------------------------------------------------------------------------------
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.onnx
*.engine
*.tflite
*.h5
*.pb
checkpoints/

# Keep model & weight directory structures tracked
!models/.gitkeep
!weights/.gitkeep

# ------------------------------------------------------------------------------
# 5. Frontend (Node.js / Next.js / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.turbo/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts.bak

# Node & package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Geospatial, Satellite Data, Patches & Pipeline Caches
# ------------------------------------------------------------------------------
cache/
data/cache/
data/patches/
data/raw/
data/processed/
data/downloads/
data/exports/
data/temp/
data/tmp/
data/*.zip
data/*.tar*
data/*.SAFE/

# GIS Auxiliary, Pyramid & Sidecar Files
*.aux.xml
*.ovr
*.rrd
*.xml.bak

# Inference & Pipeline Execution Outputs
bhuvistaar_outputs/
outputs/
generated_outputs/

# ------------------------------------------------------------------------------
# 7. Test Artifacts & Generated Inference Images in Samples
# ------------------------------------------------------------------------------
samples/*_sr_4x.*
samples/*_sr4x.*
samples/*_preview.*
samples/*preview*
samples/*test_output*
samples/*downloaded*

# Explicitly ensure core sample datasets remain tracked
!samples/sample_sentinel2_rgb_nir.tif
!samples/sample_sentinel2_rgb.tif
!samples/sample_cartosat_urban.tif
!samples/sample_urban_lr.png
!samples/satellite_sample.png
!data/train/

# ------------------------------------------------------------------------------
# 8. Testing, Profiling & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 9. Editors, IDEs & OS Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Temporary / Gradio Files
temp/
tmp/
*.log
.gradio/
