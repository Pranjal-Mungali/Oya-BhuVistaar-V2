# ==============================================================================
# BhuVistaar Frontend - Environment Variables Template
# Copy to .env.local for local frontend overrides.
# ==============================================================================

# Target FastAPI Backend URL (Client-side requests)
# Defaults to: http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Target FastAPI Backend URL (Server-side Next.js rewrites)
# Set this to your deployed cloud backend URL on Vercel/production:
# BACKEND_URL=https://your-bhuvistaar-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000
