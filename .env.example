# ==============================================================================
# BhuVistaar V2 - Environment Configuration Template
# Satellite Super-Resolution (4x) & Epistemic Uncertainty Platform
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
# Host interface to bind server (e.g. 127.0.0.1 for local, 0.0.0.0 for Docker/cloud)
HOST=127.0.0.1
# Port on which FastAPI will listen
PORT=8000
# Environment mode: development or production
ENVIRONMENT=development
# Enable/disable auto-reload and verbose debug logging
DEBUG=true
# Allowed CORS origins (comma-separated list, or '*' for unrestricted access)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Deep Learning & Inference Configuration
# ------------------------------------------------------------------------------
# Path to neural model weights checkpoint file (relative to project root or absolute)
# Default Real-ESRGAN 4x backbone: weights/RealESRGAN_x4plus.pth
# Custom trained checkpoint: models/bhuvistaar_sr_x4_best.pth
MODEL_CHECKPOINT_PATH=weights/RealESRGAN_x4plus.pth
# Compute device: auto (prefers CUDA if available), cuda, or cpu
DEVICE=auto
# Super-resolution scaling factor (default: 4x)
SCALE_FACTOR=4
# Default number of Monte Carlo Dropout stochastic passes for uncertainty quantification
DEFAULT_MC_PASSES=15
# Default colormap for uncertainty heatmap visualization (turbo, plasma, viridis, magma, inferno)
DEFAULT_COLORMAP=turbo

# ------------------------------------------------------------------------------
# 3. Storage & Cache Directories
# ------------------------------------------------------------------------------
# Directory for caching satellite tiles, intermediate processing, and staging
DATA_CACHE_DIR=data/cache
# Directory where generated inference outputs, GeoTIFFs, and previews are saved
TEMP_OUTPUT_DIR=data/cache/outputs
# Directory containing pre-packaged satellite test scenes
SAMPLES_DIR=samples

# ------------------------------------------------------------------------------
# 4. Copernicus Data Space Ecosystem (CDSE) API Credentials
# Documentation & Key Generation: https://dataspace.copernicus.eu/
# ------------------------------------------------------------------------------
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search

# ------------------------------------------------------------------------------
# 5. ISRO Bhoonidhi STAC API Credentials
# Documentation & Registration: https://bhoonidhi.nrsc.gov.in/bhoonidhi-api/
# ------------------------------------------------------------------------------
BHOONIDHI_USERNAME=
BHOONIDHI_PASSWORD=
BHOONIDHI_API_URL=https://bhoonidhi.nrsc.gov.in/bhoonidhi-api/stac/search

# ------------------------------------------------------------------------------
# 6. Frontend Integration
# ------------------------------------------------------------------------------
# Frontend dashboard origin (used for CORS and notifications)
FRONTEND_URL=http://localhost:3000
# Target backend URL exposed to Next.js client
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
